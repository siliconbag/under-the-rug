#include <windows.h>
#include "resource.h"

IDI_RUG ICON "Rug.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "Rug.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Rug"
            VALUE "ProductName", "Rug"
            VALUE "FileVersion", "0.1"
            VALUE "ProductVersion", "0.1"
            VALUE "OriginalFilename", "Rug.exe"
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
